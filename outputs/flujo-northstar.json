    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nif (!rows.length || !rows[0].json || !rows[0].json.properties) { throw new Error('reglas_ausentes'); }\nconst props = rows[0].json.properties;\nconst readText = (p) => {\n  if (!p) return '';\n  if (Array.isArray(p.rich_text)) return p.rich_text.map(t => (t.plain_text || (t.text && t.text.content) || \"\")).join(\"\").trim();\n  if (Array.isArray(p.title)) return p.title.map(t => (t.plain_text || (t.text && t.text.content) || \"\")).join(\"\").trim();\n  if (typeof p === 'string') return p.trim();\n  return '';\n};\nconst criterios = readText(props['Criterios']);\nconst tono = readText(props['Tono']);\nconst activo = props['Activo'] && props['Activo'].checkbox === true;\nif (!criterios || !tono) { throw new Error('reglas_incompletas'); }\nif (!activo) { throw new Error('reglas_inactivas'); }\nreturn { json: { criterios, tono } };"
      },
