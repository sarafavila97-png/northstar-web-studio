      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\n// Rechazar respuesta cortada (JSON potencialmente truncado)\nconst stop = item.stop_reason || (item.response && item.response.stop_reason);\nif (stop === 'max_tokens') { throw new Error('respuesta_truncada'); }\nconst blocks = item.content || [];\nconst tb = Array.isArray(blocks) ? blocks.find(b => b && b.type === 'text') : null;\nif (!tb || !tb.text) { throw new Error('sin_texto'); }\nconst bt = String.fromCharCode(96);\nlet raw = String(tb.text).trim();\nraw = raw.replace(new RegExp('^' + bt + '{3}(json)?\\\\s*'), '').replace(new RegExp('\\\\s*' + bt + '{3}$'), '');\nlet data;\ntry { data = JSON.parse(raw); } catch (e) { throw new Error('json_invalido'); }\nif (!data || typeof data !== 'object' || Array.isArray(data)) { throw new Error('json_no_objeto'); }\n// Rechazar claves ajenas y exigir las requeridas\nconst permitidas = ['puntuacion', 'clasificacion', 'motivo', 'asunto', 'cuerpo'];\nconst keys = Object.keys(data);\nfor (const k of keys) { if (!permitidas.includes(k)) { throw new Error('claves_ajenas'); } }\nfor (const k of permitidas) { if (!(k in data)) { throw new Error('faltan_claves'); } }\n// puntuacion: number entero 0..100 SIN coerción ni recorte\nconst p = data.puntuacion;\nif (typeof p !== 'number' || !Number.isInteger(p) || p < 0 || p > 100) { throw new Error('puntuacion_invalida'); }\n// clasificacion permitida\nconst clases = ['Alta', 'Media', 'Baja'];\nconst clasif = data.clasificacion;\nif (typeof clasif !== 'string' || !clases.includes(clasif)) { throw new Error('clasificacion_invalida'); }\n// coherencia puntuacion<->clasificacion\nconst esperada = p >= 70 ? 'Alta' : (p >= 40 ? 'Media' : 'Baja');\nif (clasif !== esperada) { throw new Error('clasificacion_incoherente'); }\n// strings no vacíos con límites\nconst motivo = data.motivo, asunto = data.asunto, cuerpo = data.cuerpo;\nif (typeof motivo !== 'string' || motivo.trim() === '' || motivo.length > 1000) { throw new Error('motivo_invalido'); }\nif (typeof asunto !== 'string' || asunto.trim() === '' || asunto.length > 300) { throw new Error('asunto_invalido'); }\nif (typeof cuerpo !== 'string' || cuerpo.trim() === '' || cuerpo.length > 5000) { throw new Error('cuerpo_invalido'); }\nconst usage = item.usage || {};\nconst tIn = Number(usage.input_tokens || 0);\nconst tOut = Number(usage.output_tokens || 0);\n// Precios verificados Haiku 4.5: USD 1/M input, 5/M output.\nconst PRICE_IN = 1.0 / 1000000;\nconst PRICE_OUT = 5.0 / 1000000;\nconst costo = Number((tIn * PRICE_IN + tOut * PRICE_OUT).toFixed(6));\nreturn { json: {\n  puntuacion: p, clasificacion: clasif, motivo: motivo.trim(), asunto: asunto.trim(), cuerpo,\n  tokens_in: tIn, tokens_out: tOut, costo_usd: costo\n} };"
      },
