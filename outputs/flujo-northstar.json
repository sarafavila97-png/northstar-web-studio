    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst readText = (p) => {\n  if (!p) return '';\n  if (Array.isArray(p.rich_text)) return p.rich_text.map(t => (t.plain_text || (t.text && t.text.content) || \"\")).join(\"\");\n  if (typeof p === 'string') return p;\n  return '';\n};\nlet total = 0, enviadas = 0, rechazadas = 0, errores = 0, duplicadas = 0, costo = 0;\nfor (const r of rows) {\n  const props = r && r.properties;\n  if (!props) continue;\n  total++;\n  const res = readText(props['Resultado']);\n  const err = props['Error'] && props['Error'].checkbox === true;\n  const cst = props['Costo USD'] && typeof props['Costo USD'].number === 'number' ? props['Costo USD'].number : 0;\n  if (err) errores++;\n  if (res === 'Enviada al cliente') enviadas++;\n  else if (res === 'Rechazada por revisor') rechazadas++;\n  else if (res === 'Duplicado ignorado') duplicadas++;\n  costo += cst;\n}\nconst tasa = total > 0 ? Number(((errores / total) * 100).toFixed(2)) : 0;\nreturn [{ json: {\n  total, enviadas, rechazadas, errores, duplicadas, tasa,\n  costo: Number(costo.toFixed(6))\n} }];"
      },
