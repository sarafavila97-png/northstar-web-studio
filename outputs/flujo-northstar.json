    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst DOC = '10Du79nwuwLsd3k64xlTkaHQl96I5VOsy3Yen91363QY';\nconst GID = '1573674512';\nconst get = (...keys) => {\n  for (const k of keys) {\n    if (j[k] != null && String(j[k]).trim() !== '') return String(j[k]).trim();\n  }\n  return '';\n};\n// Encabezado real confirmado: 'Marca temporal'\nconst marca = get('Marca temporal', 'Timestamp', 'marca temporal', 'timestamp');\nconst nombre = get('Nombre');\nconst correo = get('Correo electrónico', 'Correo electronico', 'Email', 'Correo').toLowerCase();\nconst negocio = get('Nombre del negocio');\nconst servicio = get('¿Qué necesitas?', '¿Que necesitas?', 'Qué necesitas', 'Que necesitas');\nlet proyecto = get('Cuéntanos sobre tu proyecto', 'Cuentanos sobre tu proyecto');\nconst presupuesto = get('Presupuesto orientativo (USD)', 'Presupuesto orientativo', 'Presupuesto');\nconst plazo = get('¿Cuándo te gustaría comenzar?', '¿Cuando te gustaria comenzar?', 'Cuándo te gustaría comenzar');\nproyecto = proyecto.slice(0, 2000);\nconst row = j.row_number || j.rowNumber || j.__rowNum__ || j.row || null;\nconst emailOk = correo.indexOf('@') > 0 && correo.indexOf('.') > correo.indexOf('@') && correo.indexOf(' ') === -1;\n// Validar los 7 campos obligatorios del formulario\nconst errores = [];\nif (!emailOk) errores.push('correo inválido');\nif (!nombre) errores.push('nombre vacío');\nif (!negocio) errores.push('negocio vacío');\nif (!servicio) errores.push('servicio vacío');\nif (!proyecto) errores.push('proyecto vacío');\nif (!presupuesto) errores.push('presupuesto vacío');\nif (!plazo) errores.push('plazo vacío');\n// Componentes idempotentes: documento+pestaña+fila; respaldo marca+correo.\nconst rawKey = row ? (DOC + ':' + GID + ':' + row) : ((marca && correo) ? (marca + '|' + correo) : '');\n// Hash estable (FNV-1a 32 bits) -> el título NO expone correo ni datos personales.\nfunction fnv1a(str) {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 0x01000193); }\n  return (h >>> 0).toString(16).padStart(8, '0');\n}\nconst clave = rawKey ? ('sol_' + fnv1a(rawKey)) : '';\nif (!clave) errores.push('sin clave idempotente');\nconst es_valido = errores.length === 0;\nreturn { json: {\n  es_valido, errores: errores.join('; '), clave,\n  marca, nombre, correo, negocio, servicio, proyecto, presupuesto, plazo\n} };"
      },
